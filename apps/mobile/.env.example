# Use your development computer's LAN IPv4 address for a physical Android phone.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8765
# Local development only; never put a production secret in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_DEV_AUTH_TOKEN=local-only-change-me
# Local development may leave these blank and use the local-only dev token above.
# EAS preview/production builds require a public project URL and publishable/legacy anon key.
# Never put a secret or service-role key in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

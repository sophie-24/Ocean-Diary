DATABASE_URL=postgresql+psycopg://ocean:ocean@localhost:5432/ocean_diary
DATABASE_CONNECT_TIMEOUT_SECONDS=5
APP_ENV=development
DEV_AUTH_ENABLED=true
DEV_AUTH_TOKEN=local-only-change-me
DEV_AUTH_USER_ID=11111111-1111-4111-8111-111111111111
SUPABASE_URL=
SUPABASE_JWKS_TIMEOUT_SECONDS=5
# Match Supabase's maximum access-token lifetime; longer JWTs are rejected.
SUPABASE_ACCESS_TOKEN_MAX_AGE_SECONDS=86400
# Server-only Supabase service role key; never add this to the mobile app environment.
SUPABASE_SERVICE_ROLE_KEY=
S3_ENDPOINT_URL=http://127.0.0.1:9000
# Set this to the computer's LAN IP for physical-device uploads.
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=ocean-diary-media
# Local development only. The API rejects these sample credentials outside development.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
UPLOAD_INTENT_TTL_SECONDS=600
DELETED_OBSERVATION_RETENTION_DAYS=30
API_HOST=0.0.0.0
API_PORT=8765
IDENTIFICATION_PROVIDER=mock
# Applies to external providers; quota resets at midnight Asia/Seoul.
MAX_IDENTIFICATION_JOBS_PER_USER_PER_DAY=20
AI_PROVIDER_FAILURE_THRESHOLD=3
AI_PROVIDER_CIRCUIT_WINDOW_SECONDS=300
AI_PROVIDER_TIMEOUT_SECONDS=45
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
MEDIA_PUBLIC_BASE_URL=


